{
  "$comment": "Binary Time design tokens v1.0 — single source of truth. Mirrored 1:1 in tokens.css. Sizes are fluid: cqmin/cqw/cqh = % of the screen's short side / width / height (CSS container units; root is the container).",
  "version": "1.0.0",
  "color": {
    "ink": "#000000",
    "paper": "#FFFFFF",
    "themes": {
      "dark": {
        "bg": "ink",
        "fg": "paper"
      },
      "light": {
        "bg": "paper",
        "fg": "ink"
      }
    }
  },
  "opacity": {
    "full": {
      "value": 1,
      "use": "Primary text, bit = 1",
      "contrast": {
        "dark": "21:1",
        "light": "21:1"
      }
    },
    "mid": {
      "value": 0.66,
      "use": "Secondary text, labels, controls at rest, whole date group",
      "resolved": {
        "dark": "#A8A8A8",
        "light": "#575757"
      },
      "contrast": {
        "dark": "8.8:1",
        "light": "7.2:1"
      }
    },
    "low": {
      "value": 0.42,
      "use": "Bit = 0 outline (non-text graphic, ≥3:1)",
      "resolved": {
        "dark": "#6B6B6B",
        "light": "#949494"
      },
      "contrast": {
        "dark": "3.9:1",
        "light": "3.0:1"
      }
    },
    "ghost": {
      "value": 0.22,
      "use": "Void (unused) bit position — decorative"
    },
    "rule": {
      "value": 0.5,
      "use": "Date/Time separator line"
    }
  },
  "font": {
    "stack": [
      "JetBrains Mono",
      "Noto Sans Hebrew",
      "Noto Sans Arabic",
      "Noto Serif Tibetan",
      "Noto Sans JP",
      "ui-monospace",
      "Menlo",
      "monospace"
    ],
    "weights": {
      "light": 300,
      "regular": 400,
      "semibold": 600
    },
    "numeric": "tabular-nums",
    "source": "Google Fonts (all OFL). Bundle locally for an offline screensaver."
  },
  "type": {
    "base": {
      "size": "clamp(11px, 1.45cqmin, 22px)"
    },
    "kicker": {
      "size": "0.82em",
      "weight": 400,
      "opacity": "mid",
      "tracking": "0.18em",
      "case": "upper"
    },
    "value": {
      "size": "1.15em",
      "weight": 600,
      "tracking": "0.06em",
      "case": "upper"
    },
    "note": {
      "size": "0.9em",
      "weight": 400,
      "opacity": "mid",
      "tracking": "0.04em"
    },
    "rowLabel": {
      "size": "0.9em",
      "weight": {
        "date": 400,
        "time": 600
      },
      "tracking": "0.18em",
      "case": "upper"
    },
    "rowSub": {
      "size": "0.85em",
      "opacity": "mid",
      "tracking": "0.08em"
    },
    "decimal": {
      "size": {
        "time": "min(b * 0.62, 2.4em)",
        "date": "min(b * 0.4, 1.6em)",
        "narrow": "1.3em"
      },
      "weight": {
        "time": 400,
        "date": 300
      }
    },
    "place": {
      "size": "clamp(9px, b * 0.2, 15px)",
      "opacity": "mid"
    },
    "separator": {
      "size": "0.78em",
      "tracking": "0.24em",
      "case": "upper",
      "opacity": "mid"
    },
    "readout": {
      "size": "1.5em",
      "narrow": "1.15em",
      "weight": 300,
      "tracking": "0.08em"
    },
    "button": {
      "size": "0.82em",
      "tracking": "0.14em",
      "case": "upper"
    },
    "scriptRules": "Tracking and uppercase apply ONLY to Latin/Cyrillic (en, ru). For he, ar, bo, ja: letter-spacing normal, no text-transform (tracking breaks Arabic joining). Tibetan: line-height 1.7."
  },
  "space": {
    "pad": "clamp(16px, 4.2cqmin, 64px)",
    "gap": "clamp(6px, 1.4cqmin, 20px)",
    "labelCol": "clamp(84px, 12cqw, 230px)",
    "decimalCol": "clamp(60px, 9cqw, 170px)",
    "separatorMargin": "gap * 1.2 (narrow: gap * 0.6)",
    "dateRowGap": "gap * 0.6",
    "chromeGap": "24px",
    "bitBlock": "One centred column, width = widest row (labelCol + w*(b+gap) + decimalCol); narrow: full width"
  },
  "bit": {
    "size": {
      "wide": "min((100cqw - 2*pad - labelCol - decimalCol - (w + 1)*gap) / w, (100cqh - 2*pad - 30cqh) / 10.4, 116px)",
      "narrow": "min((100cqw - 2*pad - (w - 1)*gap) / w, (100cqh - 2*pad - 46cqh) / 7.2, 64px)"
    },
    "columns": "w = clamp(bitLength(year), 7, 14)",
    "dateScale": 0.56,
    "states": {
      "on": "fill fg",
      "off": "outline max(1px, b * 0.055) fg at opacity.low",
      "void": "dot fg at opacity.ghost, scale 0.1"
    },
    "shape": {
      "dot": "50%",
      "square": "max(2px, b * 0.12)"
    }
  },
  "button": {
    "minHeight": "44px",
    "paddingX": "16px",
    "border": "1px solid fg",
    "radius": "999px",
    "opacityRest": "mid",
    "opacityHover": "full",
    "focus": "2px solid fg, offset 3px",
    "gap": "8px"
  },
  "motion": {
    "bit": "180ms ease (background-color, transform, opacity)",
    "hundredthsRow": "none",
    "theme": "600ms ease (background-color, color)",
    "control": "200ms (opacity)",
    "locationPulse": "2s ease-in-out infinite, opacity 1 → 0.2",
    "reducedMotion": "disable all transitions and the pulse"
  },
  "breakpoints": {
    "narrow": "container width ≤ 680px"
  }
}